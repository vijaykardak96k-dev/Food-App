# Copy this file to `.env` and adjust the values.
PORT=5000

# MySQL (Docker container from docker-compose.yml)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
# Must match MYSQL_ROOT_PASSWORD in docker-compose.yml (default: cravo_local_pw)
DB_PASSWORD=cravo_local_pw
DB_NAME=food_delivery

# Use a long random string of your own
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Frontend origin allowed by CORS
FRONTEND_URL=http://localhost:5173

# Password given to every demo account when you run `npm run seed`
DEMO_PASSWORD=Demo@1234
